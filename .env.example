# Bu dosyayi .env olarak kopyalayip degerleri kendinize gore duzenleyin.

# Sunucu portu
PORT=3000

# --- PostgreSQL (Docker Compose ile calisir: docker compose up -d) ---
POSTGRES_USER=sakin
POSTGRES_PASSWORD=degistirin-guclu-bir-sifre
POSTGRES_DB=sakin
POSTGRES_PORT=5432
# connection_limit: Prisma'nin PrismaClient basina actigi havuz boyutu -
# belirtilmezse varsayilan (num_physical_cpus*2+1, 8 cekirdekli bir makinede
# 17) kullanilir. PM2 cluster modunda (bkz. ecosystem.config.js) her worker
# KENDI PrismaClient'ini actigi icin bu, worker sayisiyla CARPILIR - 8
# worker x varsayilan 17 = 136 baglanti, Postgres'in varsayilan
# max_connections'ini (100) asar. connection_limit'i dusuk tutup worker
# sayisiyla carpiminin max_connections'in altinda kalmasini saglayin
# (orn. 10 x 8 worker = 80, Postgres Studio/migration icin 20 pay birakir).
# Worker sayisini artirirsaniz (ecosystem.config.js "instances") bu degeri
# orantili dusurun, ya da Postgres'in max_connections'ini yukseltin.
DATABASE_URL=postgresql://sakin:degistirin-guclu-bir-sifre@localhost:5432/sakin?schema=public&connection_limit=10&pool_timeout=20

# JWT icin gizli anahtar - PRODUCTIONDA MUTLAKA DEGISTIRIN
JWT_SECRET=bu-anahtari-mutlaka-degistirin-cok-uzun-ve-rastgele-yapin

# Varsayilan yonetici hesabi (ilk kurulumda otomatik olusturulur)
ADMIN_EMAIL=yonetici@site.com
ADMIN_PASSWORD=Degistir123!

# --- Asagidaki entegrasyonlar bu surumde AKTIF DEGILDIR ---
# Gercek SMS gondermek icin (Netgsm, Iletimerkezi vb.) kendi API bilgilerinizi girip
# routes/comms.js icindeki sendSms() fonksiyonunu doldurun.
# SMS_API_KEY=
# SMS_API_SECRET=

# Gercek e-posta gondermek icin (SMTP) nodemailer eklenip .env'e sunucu bilgileri girilmeli.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=

# Online kredi karti ile odeme icin bankaniz/odeme kurulusunuzun (iyzico, PayTR, bankanizin
# sanal POS'u vb.) sozlesmesi ve API bilgileri gereklidir. routes/finance.js icindeki
# /api/finance/pay-online ucu bu entegrasyon icin ayrilmis bos bir noktadir.
# PAYMENT_PROVIDER_API_KEY=
