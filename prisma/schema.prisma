generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enumlar ----------------
// Sadece ASCII, sabit/kapali deger kumeleri enum yapildi. Turkce etiket
// iceren durum/oncelik alanlari (tickets, packages, keys, reservations)
// bilerek String birakildi - hem cok sayida serbest metin degeri var hem
// de bu oturumda mantigi Prisma'ya tasinmayan route'lara ait.

enum Role {
  yonetici
  sakin
  personel
}

enum Occupancy {
  owner
  tenant
  // Yonetimcell karsilastirmasi: "Bos/Dolu Tasinmaz Listesi" raporu - kimse
  // ikamet etmeyen (ne malik ne kiraci fiilen oturuyor) tasinmazlar icin.
  vacant
}

enum AccountType {
  banka
  nakit
  pos
}

enum TransactionType {
  gelir
  gider
}

enum ChargeStatus {
  unpaid
  partial
  paid
}

enum PartyType {
  firma
  personel
}

// ---------------- Ayarlar (eski "meta") ----------------

model Settings {
  id                String   @id @default("singleton")
  buildingName      String
  address           String
  initializedAt     DateTime
  monthlyDueDefault Decimal  @db.Decimal(12, 2)
  lateFeeRate       Decimal  @db.Decimal(5, 2)
  lateFeeGraceDays  Int
  autoDueEnabled    Boolean
  autoDueDay        Int
  autoDueAmount     Decimal  @db.Decimal(12, 2)
  lastAutoDuePeriod String?
  ticketCategories  String[]
  defaultAccountId  String
  defaultAccount    Account  @relation(fields: [defaultAccountId], references: [id], onDelete: Restrict)
}

// ---------------- Daire / Kullanici ----------------

model Unit {
  id          String   @id @default(uuid())
  block       String
  no          String
  floor       Int
  ownerName   String
  ownerPhone  String
  tenantName  String
  tenantPhone String
  occupancy   Occupancy
  landShare   Decimal? @db.Decimal(7, 4)
  // "Detayli Uye Listesi" rapor olusturucusunda arsa payinin yaninda ayri
  // bir alan olarak goruldu (Yonetimcell karsilastirmasi).
  squareMeters Decimal? @db.Decimal(8, 2)
  feeGroup    String?
  accountingCode String?
  // Acik borclarin tamaminin odenmesinden sonra artan tutar buraya birikir
  // (alacakli bakiye). Otomatik hicbir borca uygulanmaz - yonetici "Krediyi
  // Borca Uygula" ile bilincli olarak tetikler (bkz. CreditApplication).
  creditBalance Decimal @db.Decimal(12, 2) @default(0)

  users            User[]
  charges          Charge[]
  payments         Payment[]
  reservations     Reservation[]
  tickets          Ticket[]
  meters           Meter[]
  packages         Package[]
  activityLogs     ActivityLog[]
  internalTasks    InternalTask[]
  creditApplications CreditApplication[]
  householdMembers HouseholdMember[]
  legalCases       LegalCase[]
}

// Yonetimcell karsilastirmasindan: "Ikamet Edenler Listesi" - o dairede
// fiilen kim yasiyor sorusunu yakinlik derecesiyle cevaplar (malik disinda
// es/cocuk/kiracidan misafire kadar). isCurrent=false olanlar "eski sakin"
// gecmisini tutar, silinmez.
model HouseholdMember {
  id           String    @id @default(uuid())
  unitId       String
  unit         Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  isCurrent    Boolean   @default(true)
  movedInAt    DateTime  @default(now())
  movedOutAt   DateTime?
}

// Uye bazli serbest not - CRM tarzi, islem kaydi degil (orn. "asansor
// anahtarini komsuya birakti" gibi yoneticinin hatirlamak istedigi bir sey).
model UserNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime @default(now())
}

// ---------------- Hukuki (Icra Takibi) ----------------
// Yonetimcell karsilastirmasindan: "Icradaki Uyeler Listesi" ve "Icradaki
// Dosyalar Listesi" ayni verinin iki farkli filtrelemesi - tek model yeterli.
model LegalCase {
  id          String    @id @default(uuid())
  unitId      String
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  caseNumber  String
  court       String
  status      String    @default("Açık")
  description String
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  createdBy   String
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  phone               String
  // Rapor olusturucuda "Cep Telefonu 1/2", "Eposta Adresi 1/2" olarak
  // gorulen ikincil iletisim alanlari (Yonetimcell karsilastirmasi) -
  // sadece bilgi amacli, email (giris icin kullanilan) gibi unique degil.
  phone2              String?
  email2              String?
  passwordHash        String
  role                Role
  unitId              String?
  unit                Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  department          String?
  nationalId          String?
  // Yonetimcell karsilastirmasi: "Detayli Uye Listesi Dokumu" rapor
  // olusturucusunda gorulen ek uye bilgileri - hepsi opsiyonel, sadece
  // bilgi amacli.
  gender              String?
  birthDate           DateTime?
  bloodType           String?
  sector              String?
  workplace           String?
  workAddress         String?
  homeAddress         String?
  isApproved          Boolean   @default(false)
  mustChangePassword  Boolean   @default(false)
  resetRequestedAt    DateTime?
  isActive            Boolean   @default(true)
  tokenVersion        Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  // Sidebar'da yildizlanan sayfalarin tab id'leri (profil ozelinde, cihazlar
  // arasi kalici) - Mert'in "favori sayfa" istegi. Sira onemli degil, ama
  // eklenme sirasi korunur.
  favoriteTabs        String[]  @default([])

  personnel        Personnel?
  payments         Payment[]
  reservations     Reservation[]
  tickets          Ticket[]
  ticketComments   TicketComment[]
  classifieds      Classifieds[]
  notifications    Notification[]
  surveyVotes      SurveyVote[]
  vehicles         Vehicle[]
  agendaItems      AgendaItem[]
  sentMessages     Message[]       @relation("MessageSender")
  receivedMessages Message[]       @relation("MessageRecipient")
  notes            UserNote[]
}

// Yonetimcell karsilastirmasindan: guvenlik/kapi gorevlisinin gozle
// tanimasi icin plaka yaninda marka/renk de tutuluyor.
model Vehicle {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plate  String
  brand  String
  color  String
}

// ---------------- Kasa / Banka Hesabi ----------------

model Account {
  id             String      @id @default(uuid())
  name           String
  type           AccountType
  bankName       String
  iban           String
  openingBalance Decimal     @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  // Yonetimcell karsilastirmasi: "Muhasebe Kodu Tanimlari" - Tekduzen Hesap
  // Plani'na gore kullanicinin kendi mali musavirine referans icin atadigi
  // serbest metin kod (orn. "102.01"). Gercek bir hesap plani hiyerarsisi
  // degil, sadece raporlama/eslestirme etiketi.
  accountingCode String?

  transactions      Transaction[]
  payments          Payment[]
  partyPayments     PartyPayment[]
  transfersFrom     Transfer[]  @relation("TransferFrom")
  transfersTo       Transfer[]  @relation("TransferTo")
  settingsDefaultFor Settings[]
}

model Transfer {
  id            String   @id @default(uuid())
  fromAccountId String
  fromAccount   Account  @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId   String
  toAccount     Account  @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime @default(now())
  description   String
  createdBy     String
}

// ---------------- Aidat / Odeme / Muhasebe ----------------

// type: bilerek enum degil String - yonetici serbestce yeni kategori
// tanimlayabilsin diye (Yonetimcell karsilastirmasi: Idari Ceza, Kidem
// Tazminati Fonu gibi site'ye ozel kategoriler). Uygulama katmaninda
// tutarlilik icin mevcut kategoriler bir datalist ile onerilir.
model Charge {
  id                    String       @id @default(uuid())
  unitId                String
  unit                  Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  type                  String
  period                String
  amount                Decimal      @db.Decimal(12, 2)
  dueDate               DateTime
  status                ChargeStatus @default(unpaid)
  paidAmount            Decimal      @db.Decimal(12, 2) @default(0)
  lateFeeAppliedPeriods String[]
  description           String
  // Firma/personel giderleriyle (PartyCharge) AYNI Gider Grubu/Kalemi
  // taksonomisini paylasir - orn. bir "Demirbas" gideri hem bir firmadan
  // alinan faturada (PartyCharge) hem de bu gideri dairelere yansitan
  // borclandirmada (Charge) ayni ExpenseCategory'yi referans alabilir.
  // `type` (serbest metin) geriye donuk uyumluluk/otomatik uretilen
  // borclar (aidat/sayac/gecikme_faizi) icin ana etiket olmaya devam
  // eder - categoryId sadece raporlama/kirlim icin ek bir siniflandirma.
  categoryId            String?
  category              ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt             DateTime     @default(now())

  allocations       PaymentAllocation[]
  meterReadings     MeterReading[]
  creditApplications CreditApplication[]

  @@index([unitId])
  @@index([categoryId])
}

model Payment {
  id            String       @id @default(uuid())
  unitId        String
  unit          Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Decimal      @db.Decimal(12, 2)
  method        String
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  date          DateTime     @default(now())
  note          String
  receiptNo     String
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  cancelled     Boolean      @default(false)
  cancelledAt   DateTime?
  cancelledBy   String?
  // Odeme, acik borclarin tamamini kapattiktan sonra artan tutar - metne
  // gomulmek yerine Unit.creditBalance'a eklenir, bu alan ne kadarinin
  // eklendigini kaydeder (iptal edilirse dogru miktari geri dusebilmek icin).
  creditAmount  Decimal      @db.Decimal(12, 2) @default(0)
  // creditAmount'in ne kadari HALA havuzda duruyor (apply-credit ile baska
  // bir borca harcanmamis). Iptal sirasinda SADECE bu kadari geri alinir -
  // boylece bu odemenin katkisi baska bir odemenin katkisiyla karismaz
  // (havuz paylasilan tek bir sayi oldugu icin, hangi odemenin ne kadar
  // "hala orada" oldugunu ayrica izlemek gerekiyor).
  creditRemaining Decimal    @db.Decimal(12, 2) @default(0)

  allocations PaymentAllocation[]

  @@index([unitId])
}

// Bir dairenin fazla odemesinin bir sonraki/acik borca yonetici tarafindan
// bilincli, tek tikla uygulanmasinin kaydi (otomatik/sessiz degil - Sakin'in
// "her sey gorunur ve izlenebilir olsun" ilkesine uygun).
model CreditApplication {
  id        String   @id @default(uuid())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  chargeId  String
  charge    Charge   @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  createdBy String
}

model PaymentAllocation {
  id        String  @id @default(uuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  chargeId  String
  charge    Charge  @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  amount    Decimal @db.Decimal(12, 2)
}

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  category    String
  amount      Decimal         @db.Decimal(12, 2)
  accountId   String
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  date        DateTime        @default(now())
  description String
  createdBy   String

  payment      Payment?
  partyPayment PartyPayment?

  @@index([accountId])
}

// Odeme isteklerinin mukerrer islenmesini engellemek icin: id = client'in
// gonderdigi requestId, unique constraint DB seviyesinde korur.
model PaymentRequest {
  id        String   @id
  createdAt DateTime @default(now())
}

model Budget {
  id            String  @id @default(uuid())
  year          Int
  category      String
  plannedAmount Decimal @db.Decimal(12, 2)
  createdBy     String

  @@unique([year, category])
}

// ---------------- Firma & Personel Cari Hesap ----------------

model Vendor {
  id          String   @id @default(uuid())
  name        String
  category    String
  contactName String   @default("")
  phone       String
  email       String   @default("")
  taxNumber   String
  iban        String
  notes       String
  accountingCode String?
  createdAt   DateTime @default(now())
}

// Gider Grubu -> Gider kalemi hiyerarsisi (Yonetimcell karsilastirmasi:
// "Giderler (Odeme)" modulunun temeli - her borc/fatura bir kategoriye
// baglanabilir, taraf zorunlu degil).
model ExpenseCategory {
  id        String   @id @default(uuid())
  accountingCode String?
  group     String
  name      String
  createdAt DateTime @default(now())

  partyCharges     PartyCharge[]
  recurringCharges RecurringPartyCharge[]
  charges          Charge[]
  expenseProjects  ExpenseProject[]

  @@index([group])
}

// Yonetimcell karsilastirmasi: "İşletme Projesi" - bir gideri (orn. bakim
// sozlesmesi) belirli bir donem araligi boyunca m2/arsa payi/esit paylasima
// gore tasinmazlara TOPLU borclandiran arac. "Kaydet" ile her ay+tasinmaz
// icin ayri bir Charge olusturur (bkz. routes/finance.js apply-project).
model ExpenseProject {
  id            String   @id @default(uuid())
  name          String
  startPeriod   String   // "2026-01" (Charge.period ile ayni format)
  endPeriod     String   // "2026-12"
  categoryId    String?
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shareMethod   String   // "metrekare" | "arsapayi" | "esit"
  monthlyAmount Decimal  @db.Decimal(12, 2)
  blockFilter   String?  // null = tum bloklar
  status        String   @default("draft") // "draft" | "applied"
  createdBy     String
  createdAt     DateTime @default(now())
}

// "Ileri Tarihli Borc Listesi" / Tekrarlayan Faturalar (Yonetimcell
// karsilastirmasi): bir sablon tanimlanir (taraf VEYA kategori, tutar,
// aciklama, ilk vade), zamanlanmis gorev (jobs.js, runMaintenanceTasks)
// vadesi geldiginde bunu gercek bir PartyCharge'a cevirir. frequency="once"
// ise bir kez calisip pasif olur, "monthly"/"yearly" ise bir sonraki
// vadeye atlar.
model RecurringPartyCharge {
  id          String           @id @default(uuid())
  partyType   PartyType?
  partyId     String?
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description String
  amount      Decimal          @db.Decimal(12, 2)
  nextDate    DateTime
  frequency   String
  active      Boolean          @default(true)
  createdBy   String
  createdAt   DateTime         @default(now())

  @@index([active, nextDate])
}

// partyId, partyType'a gore vendors.id VEYA personnel.id'ye referans verir
// (polymorphic) - iki farkli tabloya tek FK Postgres'te temiz ifade
// edilemedigi icin bilerek FK'siz birakildi, mevcut davranisla ayni.
// partyType/partyId ikisi de null olabilir - "genel gider" (belirli bir
// firma/personele bagli olmayan, sadece kategoriye baglanan borc) icin.
model PartyCharge {
  id          String       @id @default(uuid())
  partyType   PartyType?
  partyId     String?
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amount      Decimal      @db.Decimal(12, 2)
  paidAmount  Decimal      @db.Decimal(12, 2) @default(0)
  status      ChargeStatus @default(unpaid)
  description String
  invoiceNo   String       @default("")
  date        DateTime     @default(now())
  dueDate     DateTime
  createdBy   String
  // Yonetimcell karsilastirmasi: "Borc Listesi"nde her satira fatura/makbuz
  // dosyasi eklenebiliyordu - diskte UUID adiyla saklanir (bkz. archive.js
  // pattern), orijinal ad sadece indirirken oneri olarak kullanilir.
  attachmentStoredName   String?
  attachmentOriginalName String?

  allocations PartyPaymentAllocation[]

  @@index([partyType, partyId])
  @@index([categoryId])
}

model PartyPayment {
  id            String       @id @default(uuid())
  partyType     PartyType?
  partyId       String?
  amount        Decimal      @db.Decimal(12, 2)
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  method        String
  description   String
  receiptNo     String       @default("")
  date          DateTime     @default(now())
  createdBy     String
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  cancelled     Boolean      @default(false)
  cancelledAt   DateTime?
  cancelledBy   String?

  allocations PartyPaymentAllocation[]

  @@index([partyType, partyId])
}

model PartyPaymentAllocation {
  id             String       @id @default(uuid())
  partyPaymentId String
  partyPayment   PartyPayment @relation(fields: [partyPaymentId], references: [id], onDelete: Cascade)
  partyChargeId  String
  partyCharge    PartyCharge  @relation(fields: [partyChargeId], references: [id], onDelete: Restrict)
  amount         Decimal      @db.Decimal(12, 2)
}

// ---------------- Personel ----------------

model Personnel {
  id            String  @id @default(uuid())
  name          String
  phone         String
  department    String
  active        Boolean @default(true)
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  monthlySalary Decimal? @db.Decimal(12, 2)
  accountingCode String?

  equipmentResponsible Equipment[]
  ticketsAssigned      Ticket[]
  internalTasks        InternalTask[]
}

// ---------------- Demirbas / Bakim ----------------

model Equipment {
  id                     String    @id @default(uuid())
  name                   String
  location               String
  purchaseDate           DateTime
  warrantyUntil          DateTime?
  responsiblePersonnelId String?
  responsiblePersonnel   Personnel? @relation(fields: [responsiblePersonnelId], references: [id], onDelete: SetNull)
  maintenancePeriodDays  Int
  lastMaintenanceDate    DateTime?
  notes                  String

  maintenanceHistory MaintenanceRecord[]
}

model MaintenanceRecord {
  id          String    @id @default(uuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  date        DateTime  @default(now())
  by          String
  notes       String
}

// ---------------- Sayac ----------------

model Meter {
  id       String @id @default(uuid())
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  type     String
  serialNo String

  readings MeterReading[]
}

model MeterReading {
  id       String   @id @default(uuid())
  meterId  String
  meter    Meter    @relation(fields: [meterId], references: [id], onDelete: Restrict)
  period   String
  value    Decimal  @db.Decimal(12, 2)
  unitCost Decimal  @db.Decimal(12, 2)
  amount   Decimal  @db.Decimal(12, 2)
  date     DateTime @default(now())
  chargeId String?
  charge   Charge?  @relation(fields: [chargeId], references: [id], onDelete: SetNull)
}

// ---------------- Kargo ----------------

model Package {
  id            String    @id @default(uuid())
  unitId        String
  unit          Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  courier       String
  trackingNo    String
  receivedDate  DateTime  @default(now())
  deliveredDate DateTime?
  status        String
  deliveredBy   String
}

// ---------------- Karar Defteri / Anahtar ----------------

model Decision {
  id         String   @id @default(uuid())
  decisionNo Int
  date       DateTime @default(now())
  title      String
  content    String
  attendees  Int
  createdBy  String
}

model Key {
  id           String    @id @default(uuid())
  keyName      String
  location     String
  status       String
  holderName   String
  givenDate    DateTime?
  returnedDate DateTime?

  history KeyAssignment[]
}

model KeyAssignment {
  id           String    @id @default(uuid())
  keyId        String
  key          Key       @relation(fields: [keyId], references: [id], onDelete: Cascade)
  holderName   String
  givenDate    DateTime?
  returnedDate DateTime?
}

// ---------------- Duyuru / Anket / Ortak Alan / Ariza ----------------

model Announcement {
  id       String   @id @default(uuid())
  title    String
  body     String
  date     DateTime @default(now())
  authorId String
  pinned   Boolean  @default(false)
}

model Survey {
  id        String   @id @default(uuid())
  question  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  options SurveyOption[]
  votes   SurveyVote[]
}

model SurveyOption {
  id       String @id @default(uuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  text     String
  votes    Int    @default(0)
}

// "bir kullanici bir kere oy verebilir" kisitini DB'ye devreder (eski
// votedBy[] dizisindeki .includes() kontrolunun yerini alir).
model SurveyVote {
  id        String   @id @default(uuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([surveyId, userId])
}

model Facility {
  id       String @id @default(uuid())
  name     String
  capacity Int
  rules    String

  reservations Reservation[]
}

model Reservation {
  id         String   @id @default(uuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  date       DateTime
  startTime  String
  endTime    String
  status     String
  createdAt  DateTime @default(now())
}

model Ticket {
  id                  String     @id @default(uuid())
  unitId              String
  unit                Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  category            String
  title               String
  description         String
  priority            String
  status              String
  assignedPersonnelId String?
  assignedPersonnel   Personnel? @relation(fields: [assignedPersonnelId], references: [id], onDelete: SetNull)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @default(now())

  comments TicketComment[]
}

model TicketComment {
  id       String   @id @default(uuid())
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  text     String
  date     DateTime @default(now())
}

model Classifieds {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  type        String
  title       String
  description String
  date        DateTime @default(now())
  resolved    Boolean  @default(false)
}

model Notification {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message String
  read    Boolean  @default(false)
  date    DateTime @default(now())
  link    String
}

// ---------------- Seffaflik / Rehber ----------------

model ActivityLog {
  id          String   @id @default(uuid())
  actorId     String
  actorName   String
  action      String
  detail      String
  date        DateTime @default(now())
  scopeUnitId String?
  scopeUnit   Unit?    @relation(fields: [scopeUnitId], references: [id], onDelete: SetNull)

  @@index([date])
}

model Contact {
  id    String @id @default(uuid())
  name  String
  role  String
  phone String
}

// ---------------- Ajanda / Is Takibi / Gelen Mesajlar ----------------
// Yonetimcell karsilastirmasindan: yonetimin kendi ic calisma alani -
// sakin taleplerinden (Ticket) ayri, sadece yonetici/personelin gordugu.

enum AgendaKind {
  not
  faaliyet
}

// Yonetimcell karsilastirmasi: "Denetim Kurulu Raporu" ve "Yonetim Faaliyet
// Raporu" - mali veri (Genel Durum Raporu ile ayni hesaplamadan canli
// uretilir, burada SAKLANMAZ) + iki serbest metin bolumu (idari inceleme +
// sonuc) icin resmi rapor sablonu. type alaniyla iki rapor turu ayni
// tabloda tutulur (Ajanda pattern'iyle tutarli).
model OfficialReport {
  id         String   @id @default(uuid())
  type       String   // "denetim" | "faaliyet"
  title      String
  startDate  DateTime
  endDate    DateTime
  adminText  String   @default("")
  resultText String   @default("")
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([type])
}

// "Ajanda (Notlar)" ve "Ajanda (Faaliyetler)" Yonetimcell'de ayni arayuzu
// paylasiyor, sadece cerceveleme (serbest not vs. sitede gerceklesen olay)
// farkli - bu yuzden tek model + kind alani yeterli, iki ayri tablo gerekmiyor.
model AgendaItem {
  id        String     @id @default(uuid())
  kind      AgendaKind
  date      DateTime
  text      String
  done      Boolean    @default(false)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([date])
}

// Yonetimin kendi dahili is/gorev takibi - sakin taleplerinden (Ticket) farkli,
// "asansor firmasini ara" gibi disariya kapali islerdir. Durum serbest metin
// (Ticket.status ile ayni desen): Devam Eden / Tamamlanan / Kapatilan.
model InternalTask {
  id                  String     @id @default(uuid())
  title               String
  description         String
  area                String
  type                String
  status              String     @default("Devam Eden")
  assignedPersonnelId String?
  assignedPersonnel   Personnel? @relation(fields: [assignedPersonnelId], references: [id], onDelete: SetNull)
  unitId              String?
  unit                Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  dueDate             DateTime?
  createdBy           String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @default(now())
}

// Sakin-yonetici arasi ozel (iki yonlu) mesajlasma - duyuru/pano tek yonlu
// oldugu icin ayri. recipientId bos ise "yonetime" (tum yoneticilere) gonderilmis
// sayilir; yonetici cevaplarken belirli bir sakine (recipientId) yazar.
model Message {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   User?    @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  body        String
  date        DateTime @default(now())
  read        Boolean  @default(false)

  @@index([date])
}

// ---------------- Dosya Arsivi ----------------
// Yonetimcell karsilastirmasi: klasor bazli genel evrak/dosya yukleme-saklama
// sistemi (Personel Evraklari, Maas Bordrolari, SGK Odemeleri, Uye Evraklari
// gibi). Gercek dosyalar yerel diskte (uploads/archive/) UUID adiyla
// saklanir - orijinal dosya adi asla disk yolu olarak kullanilmaz (path
// traversal riskini onlemek icin), sadece indirirken oneri adi olarak gosterilir.
model ArchiveFolder {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  createdBy String

  files ArchiveFile[]
}

model ArchiveFile {
  id           String        @id @default(uuid())
  folderId     String
  folder       ArchiveFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  storedName   String
  originalName String
  mimeType     String
  size         Int
  uploadedBy   String
  uploadedAt   DateTime      @default(now())

  @@index([folderId])
}

// ---------------- Bilgi Bankasi ----------------
// Yonetimcell karsilastirmasi: Hukuki menusu altinda kategorize edilmis,
// aranabilir bir bilgi/yardim makaleleri kutuphanesi (Bilgi Bankasi/Ornek
// Yazismalar/Yonetmelikler). Yonetimcell'de bu icerik onlarin kendi editoryal
// (telifli) metinleriydi - bizde ayni MEKANIZMA kuruldu, ornek icerikler
// bagimsiz/orijinal olarak yazildi, yonetici sonradan kendi metinleriyle
// dolduracak.
model KnowledgeArticle {
  id        String   @id @default(uuid())
  category  String
  title     String
  content   String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}
