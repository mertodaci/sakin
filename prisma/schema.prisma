generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enumlar ----------------
// Sadece ASCII, sabit/kapali deger kumeleri enum yapildi. Turkce etiket
// iceren durum/oncelik alanlari (tickets, packages, keys, reservations)
// bilerek String birakildi - hem cok sayida serbest metin degeri var hem
// de bu oturumda mantigi Prisma'ya tasinmayan route'lara ait.

enum Role {
  yonetici
  sakin
  personel
}

enum Occupancy {
  owner
  tenant
}

enum AccountType {
  banka
  nakit
  pos
}

enum TransactionType {
  gelir
  gider
}

enum ChargeType {
  aidat
  sayac
  diger
  gecikme_faizi
}

enum ChargeStatus {
  unpaid
  partial
  paid
}

enum PartyType {
  firma
  personel
}

// ---------------- Ayarlar (eski "meta") ----------------

model Settings {
  id                String   @id @default("singleton")
  buildingName      String
  address           String
  initializedAt     DateTime
  monthlyDueDefault Decimal  @db.Decimal(12, 2)
  lateFeeRate       Decimal  @db.Decimal(5, 2)
  lateFeeGraceDays  Int
  autoDueEnabled    Boolean
  autoDueDay        Int
  autoDueAmount     Decimal  @db.Decimal(12, 2)
  lastAutoDuePeriod String?
  ticketCategories  String[]
  defaultAccountId  String
  defaultAccount    Account  @relation(fields: [defaultAccountId], references: [id], onDelete: Restrict)
}

// ---------------- Daire / Kullanici ----------------

model Unit {
  id          String @id @default(uuid())
  block       String
  no          String
  floor       Int
  ownerName   String
  ownerPhone  String
  tenantName  String
  tenantPhone String
  occupancy   Occupancy

  users        User[]
  charges      Charge[]
  payments     Payment[]
  reservations Reservation[]
  tickets      Ticket[]
  meters       Meter[]
  packages     Package[]
  activityLogs ActivityLog[]
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  phone               String
  passwordHash        String
  role                Role
  unitId              String?
  unit                Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  department          String?
  isApproved          Boolean   @default(false)
  mustChangePassword  Boolean   @default(false)
  resetRequestedAt    DateTime?
  isActive            Boolean   @default(true)
  tokenVersion        Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())

  personnel      Personnel?
  payments       Payment[]
  reservations   Reservation[]
  tickets        Ticket[]
  ticketComments TicketComment[]
  classifieds    Classifieds[]
  notifications  Notification[]
  surveyVotes    SurveyVote[]
}

// ---------------- Kasa / Banka Hesabi ----------------

model Account {
  id             String      @id @default(uuid())
  name           String
  type           AccountType
  bankName       String
  iban           String
  openingBalance Decimal     @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())

  transactions      Transaction[]
  payments          Payment[]
  partyPayments     PartyPayment[]
  transfersFrom     Transfer[]  @relation("TransferFrom")
  transfersTo       Transfer[]  @relation("TransferTo")
  settingsDefaultFor Settings[]
}

model Transfer {
  id            String   @id @default(uuid())
  fromAccountId String
  fromAccount   Account  @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId   String
  toAccount     Account  @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime @default(now())
  description   String
  createdBy     String
}

// ---------------- Aidat / Odeme / Muhasebe ----------------

model Charge {
  id                    String       @id @default(uuid())
  unitId                String
  unit                  Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  type                  ChargeType
  period                String
  amount                Decimal      @db.Decimal(12, 2)
  dueDate               DateTime
  status                ChargeStatus @default(unpaid)
  paidAmount            Decimal      @db.Decimal(12, 2) @default(0)
  lateFeeAppliedPeriods String[]
  description           String
  createdAt             DateTime     @default(now())

  allocations   PaymentAllocation[]
  meterReadings MeterReading[]

  @@index([unitId])
}

model Payment {
  id            String       @id @default(uuid())
  unitId        String
  unit          Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Decimal      @db.Decimal(12, 2)
  method        String
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  date          DateTime     @default(now())
  note          String
  receiptNo     String
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  cancelled     Boolean      @default(false)
  cancelledAt   DateTime?
  cancelledBy   String?

  allocations PaymentAllocation[]

  @@index([unitId])
}

model PaymentAllocation {
  id        String  @id @default(uuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  chargeId  String
  charge    Charge  @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  amount    Decimal @db.Decimal(12, 2)
}

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  category    String
  amount      Decimal         @db.Decimal(12, 2)
  accountId   String
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  date        DateTime        @default(now())
  description String
  createdBy   String

  payment      Payment?
  partyPayment PartyPayment?

  @@index([accountId])
}

// Odeme isteklerinin mukerrer islenmesini engellemek icin: id = client'in
// gonderdigi requestId, unique constraint DB seviyesinde korur.
model PaymentRequest {
  id        String   @id
  createdAt DateTime @default(now())
}

model Budget {
  id            String  @id @default(uuid())
  year          Int
  category      String
  plannedAmount Decimal @db.Decimal(12, 2)
  createdBy     String

  @@unique([year, category])
}

// ---------------- Firma & Personel Cari Hesap ----------------

model Vendor {
  id        String   @id @default(uuid())
  name      String
  category  String
  phone     String
  taxNumber String
  iban      String
  notes     String
  createdAt DateTime @default(now())
}

// partyId, partyType'a gore vendors.id VEYA personnel.id'ye referans verir
// (polymorphic) - iki farkli tabloya tek FK Postgres'te temiz ifade
// edilemedigi icin bilerek FK'siz birakildi, mevcut davranisla ayni.
model PartyCharge {
  id          String       @id @default(uuid())
  partyType   PartyType
  partyId     String
  amount      Decimal      @db.Decimal(12, 2)
  paidAmount  Decimal      @db.Decimal(12, 2) @default(0)
  status      ChargeStatus @default(unpaid)
  description String
  date        DateTime     @default(now())
  dueDate     DateTime
  createdBy   String

  allocations PartyPaymentAllocation[]

  @@index([partyType, partyId])
}

model PartyPayment {
  id            String       @id @default(uuid())
  partyType     PartyType
  partyId       String
  amount        Decimal      @db.Decimal(12, 2)
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  method        String
  description   String
  date          DateTime     @default(now())
  createdBy     String
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  cancelled     Boolean      @default(false)
  cancelledAt   DateTime?
  cancelledBy   String?

  allocations PartyPaymentAllocation[]

  @@index([partyType, partyId])
}

model PartyPaymentAllocation {
  id             String       @id @default(uuid())
  partyPaymentId String
  partyPayment   PartyPayment @relation(fields: [partyPaymentId], references: [id], onDelete: Cascade)
  partyChargeId  String
  partyCharge    PartyCharge  @relation(fields: [partyChargeId], references: [id], onDelete: Restrict)
  amount         Decimal      @db.Decimal(12, 2)
}

// ---------------- Personel ----------------

model Personnel {
  id            String  @id @default(uuid())
  name          String
  phone         String
  department    String
  active        Boolean @default(true)
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  monthlySalary Decimal? @db.Decimal(12, 2)

  equipmentResponsible Equipment[]
  ticketsAssigned      Ticket[]
}

// ---------------- Demirbas / Bakim ----------------

model Equipment {
  id                     String    @id @default(uuid())
  name                   String
  location               String
  purchaseDate           DateTime
  warrantyUntil          DateTime?
  responsiblePersonnelId String?
  responsiblePersonnel   Personnel? @relation(fields: [responsiblePersonnelId], references: [id], onDelete: SetNull)
  maintenancePeriodDays  Int
  lastMaintenanceDate    DateTime?
  notes                  String

  maintenanceHistory MaintenanceRecord[]
}

model MaintenanceRecord {
  id          String    @id @default(uuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  date        DateTime  @default(now())
  by          String
  notes       String
}

// ---------------- Sayac ----------------

model Meter {
  id       String @id @default(uuid())
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  type     String
  serialNo String

  readings MeterReading[]
}

model MeterReading {
  id       String   @id @default(uuid())
  meterId  String
  meter    Meter    @relation(fields: [meterId], references: [id], onDelete: Restrict)
  period   String
  value    Decimal  @db.Decimal(12, 2)
  unitCost Decimal  @db.Decimal(12, 2)
  amount   Decimal  @db.Decimal(12, 2)
  date     DateTime @default(now())
  chargeId String?
  charge   Charge?  @relation(fields: [chargeId], references: [id], onDelete: SetNull)
}

// ---------------- Kargo ----------------

model Package {
  id            String    @id @default(uuid())
  unitId        String
  unit          Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  courier       String
  trackingNo    String
  receivedDate  DateTime  @default(now())
  deliveredDate DateTime?
  status        String
  deliveredBy   String
}

// ---------------- Karar Defteri / Anahtar ----------------

model Decision {
  id         String   @id @default(uuid())
  decisionNo Int
  date       DateTime @default(now())
  title      String
  content    String
  attendees  Int
  createdBy  String
}

model Key {
  id           String    @id @default(uuid())
  keyName      String
  location     String
  status       String
  holderName   String
  givenDate    DateTime?
  returnedDate DateTime?

  history KeyAssignment[]
}

model KeyAssignment {
  id           String    @id @default(uuid())
  keyId        String
  key          Key       @relation(fields: [keyId], references: [id], onDelete: Cascade)
  holderName   String
  givenDate    DateTime?
  returnedDate DateTime?
}

// ---------------- Duyuru / Anket / Ortak Alan / Ariza ----------------

model Announcement {
  id       String   @id @default(uuid())
  title    String
  body     String
  date     DateTime @default(now())
  authorId String
  pinned   Boolean  @default(false)
}

model Survey {
  id        String   @id @default(uuid())
  question  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  options SurveyOption[]
  votes   SurveyVote[]
}

model SurveyOption {
  id       String @id @default(uuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  text     String
  votes    Int    @default(0)
}

// "bir kullanici bir kere oy verebilir" kisitini DB'ye devreder (eski
// votedBy[] dizisindeki .includes() kontrolunun yerini alir).
model SurveyVote {
  id        String   @id @default(uuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([surveyId, userId])
}

model Facility {
  id       String @id @default(uuid())
  name     String
  capacity Int
  rules    String

  reservations Reservation[]
}

model Reservation {
  id         String   @id @default(uuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  date       DateTime
  startTime  String
  endTime    String
  status     String
  createdAt  DateTime @default(now())
}

model Ticket {
  id                  String     @id @default(uuid())
  unitId              String
  unit                Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  category            String
  title               String
  description         String
  priority            String
  status              String
  assignedPersonnelId String?
  assignedPersonnel   Personnel? @relation(fields: [assignedPersonnelId], references: [id], onDelete: SetNull)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @default(now())

  comments TicketComment[]
}

model TicketComment {
  id       String   @id @default(uuid())
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  text     String
  date     DateTime @default(now())
}

model Classifieds {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  type        String
  title       String
  description String
  date        DateTime @default(now())
  resolved    Boolean  @default(false)
}

model Notification {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message String
  read    Boolean  @default(false)
  date    DateTime @default(now())
  link    String
}

// ---------------- Seffaflik / Rehber ----------------

model ActivityLog {
  id          String   @id @default(uuid())
  actorId     String
  actorName   String
  action      String
  detail      String
  date        DateTime @default(now())
  scopeUnitId String?
  scopeUnit   Unit?    @relation(fields: [scopeUnitId], references: [id], onDelete: SetNull)

  @@index([date])
}

model Contact {
  id    String @id @default(uuid())
  name  String
  role  String
  phone String
}
